{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "customId": { "type": "string", "description": "Unique Otaku ID (e.g. #Otaku1234)" },
        "photoURL": { "type": "string" },
        "bannerURL": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "MARATONANDO"] },
        "currentActivity": { "type": "string", "description": "Current anime/manga being watched/read" },
        "lastOnlineAt": { "type": "string", "format": "date-time" },
        "otakuPoints": { "type": "number", "description": "Total Otaku Points (PO)" },
        "weeklyPoints": { "type": "number", "description": "Points earned in the current weekly season" },
        "rank": { "type": "string", "enum": ["FERRO", "BRONZE", "PRATA", "OURO", "PLATINA", "DIAMANTE", "DESAFIANTE"] },
        "division": { "type": "string", "description": "Current division for the user (e.g., Division 4)" },
        "lastActivityAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "joinedDate": { "type": "string" },
        "favoriteAnime": { "type": "string" },
        "favoriteGenres": { "type": "array", "items": { "type": "string" } },
        "preferences": {
          "type": "object",
          "properties": {
            "darkMode": { "type": "boolean" },
            "colorTheme": { "type": "string" },
            "language": { "type": "string" }
          }
        }
      },
      "required": ["uid", "username"]
    },
    "friendship": {
      "title": "Friendship",
      "description": "Relationship between two users",
      "type": "object",
      "properties": {
        "users": { "type": "array", "items": { "type": "string" }, "description": "UIDs of the two friends" },
        "since": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["ACCEPTED", "BLOCKED"] }
      }
    },
    "friendRequest": {
      "title": "Friend Request",
      "description": "Pending friend request",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "chat": {
      "title": "Chat Session",
      "description": "A conversation between friends",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "message": {
      "title": "Message",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["TEXT", "MEDIA", "ACHIEVEMENT"] },
        "mediaId": { "type": "integer", "description": "Optional ID of anime/manga shared" },
        "achievementId": { "type": "string", "description": "Optional ID of achievement shared" },
        "isSpoiler": { "type": "boolean" },
        "sticker": { "type": "string", "description": "Anime reaction sticker identifier" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "activityEvent": {
      "title": "Activity Event",
      "description": "A public update in the user's feed",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["COMPLETED", "PROGRESS", "ACHIEVEMENT_UNLOCKED"] },
        "mediaId": { "type": "integer" },
        "mediaTitle": { "type": "string" },
        "mediaImage": { "type": "string" },
        "achievementTitle": { "type": "string" },
        "progress": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "achievement": {
      "title": "Achievement",
      "description": "A badge earned by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "rarity": { "type": "string", "enum": ["COMUM", "RARO", "EPICO", "LENDARIO"] },
        "unlockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "favoriteCharacter": {
      "title": "Favorite Character",
      "description": "A character favorited by the user",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "animeTitle": { "type": "string" },
        "role": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      }
    },
    "mediaListItem": {
      "title": "Media List Item",
      "description": "An anime or manga in a user's list",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "mediaId": { "type": "integer" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["ANIME", "MANGA"] },
        "status": { "type": "string", "enum": ["WATCHING", "READING", "COMPLETED", "PLANNING", "DROPPED"] },
        "score": { "type": "number" },
        "progress": { "type": "number" },
        "totalVolumes": { "type": "number" },
        "totalChapters": { "type": "number" },
        "totalEpisodes": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mediaId", "type", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile data"
    },
    "users/{userId}/list/{mediaId}": {
      "schema": "mediaListItem",
      "description": "User's anime and manga list items"
    },
    "users/{userId}/achievements/{achievementId}": {
      "schema": "achievement",
      "description": "Badges earned by the user"
    },
    "users/{userId}/favorites/characters/{characterId}": {
      "schema": "favoriteCharacter",
      "description": "User's favorite characters"
    },
    "friendships/{friendshipId}": {
      "schema": "friendship",
      "description": "Friendship records"
    },
    "friendRequests/{requestId}": {
      "schema": "friendRequest",
      "description": "Pending friend requests"
    },
    "chats/{chatId}": {
      "schema": "chat",
      "description": "Conversation threads"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "message",
      "description": "Individual messages in a chat"
    },
    "activityFeed/{eventId}": {
      "schema": "activityEvent",
      "description": "System-wide activity events"
    },
    "users/{userId}/private/info": {
      "schema": "object",
      "description": "Private user information (email, status)"
    }
  }
}
