rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Hardened Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isStaff() { return isSignedIn() && request.auth.token.email in ['caue.nanda.tavares@gmail.com']; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Entity Validation Blueprints
    function isValidUser(data) {
      return (data.get('uid', null) == null || data.uid is string) &&
             (data.get('username', null) == null || (data.username is string && data.username.size() >= 1 && data.username.size() <= 64));
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (incoming().get('count', 0) >= existing().get('count', 0)) || isStaff();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming())) || isStaff();
      allow delete: if isStaff();
      
      match /private/info {
        allow read: if isOwner(userId) || isStaff();
        allow write: if isOwner(userId);
      }
      match /achievements/{achId} {
        allow read, list: if isSignedIn();
        allow create, update: if isOwner(userId) || isStaff();
        allow delete: if isStaff();
      }
      match /list/{mediaId} {
        allow read, list: if isSignedIn();
        allow create, update: if isOwner(userId) || isStaff();
        allow delete: if isOwner(userId) || isStaff();
      }
      match /notifications/{notifId} {
        allow read, list: if isOwner(userId);
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isStaff();
      }
      match /favorites/characters/items/{itemId} {
        allow read, list: if isSignedIn();
        allow create, update, delete: if isOwner(userId) || isStaff();
      }
      match /activeDevices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /friendRequests/{requestId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isSignedIn() && incoming().from == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == existing().to || request.auth.uid == existing().from);
      allow delete: if isSignedIn() && (request.auth.uid == existing().from || request.auth.uid == existing().to || isStaff());
    }

    match /friendships/{friendshipId} {
      allow read, list: if isSignedIn() && ((resource.data.get('users', null) != null && request.auth.uid in resource.data.users) || friendshipId.matches('.*' + request.auth.uid + '.*') || isStaff());
      allow create: if isSignedIn() && ((incoming().get('users', null) != null && request.auth.uid in incoming().users) || friendshipId.matches('.*' + request.auth.uid + '.*'));
      allow delete: if isSignedIn() && ((resource.data.get('users', null) != null && request.auth.uid in resource.data.users) || friendshipId.matches('.*' + request.auth.uid + '.*') || isStaff());
    }

    match /activityFeed/{eventId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().from == request.auth.uid);
      allow delete: if isStaff();
    }

    match /chats/{chatId} {
      allow read, update, list: if isSignedIn() && ((resource.data.get('participants', null) != null && request.auth.uid in resource.data.participants) || chatId.matches('.*' + request.auth.uid + '.*') || isStaff());
      allow create: if isSignedIn() && ((incoming().get('participants', null) != null && request.auth.uid in incoming().participants) || chatId.matches('.*' + request.auth.uid + '.*'));
      allow delete: if isSignedIn() && ((resource.data.get('participants', null) != null && request.auth.uid in resource.data.participants) || chatId.matches('.*' + request.auth.uid + '.*') || isStaff());
      
      match /messages/{messageId} {
        allow read, list: if isSignedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) || 
          chatId.matches('.*' + request.auth.uid + '.*') || 
          isStaff()
        );
        allow create: if isSignedIn() && (incoming().senderId == request.auth.uid);
        allow delete: if isSignedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) || 
          chatId.matches('.*' + request.auth.uid + '.*') || 
          isStaff()
        );
      }
    }

    match /global_media_stats/{animeId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /broadcasts/{broadcastId} {
      allow read, list: if isSignedIn();
      allow write: if isStaff();
    }

    match /auditLogs/{logId} {
      allow read, list: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }
  }
}
