rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Hardened Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Entity Validation Blueprints (Anti-Update-Gap)
    
    function isValidUser(data) {
      return data.uid is string && data.uid.size() == 28 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 32 &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (data.bannerURL == null || (data.bannerURL is string && data.bannerURL.size() <= 1024)) &&
             (data.bio == null || (data.bio is string && data.bio.size() <= 1000)) &&
             data.otakuPoints is number && data.otakuPoints >= 0 &&
             (data.availablePoints == null || (data.availablePoints is number && data.availablePoints >= 0)) &&
             data.rank in ['FERRO', 'BRONZE', 'PRATA', 'OURO', 'PLATINA', 'DIAMANTE', 'DESAFIANTE'];
    }

    function isValidPrivateInfo(data) {
      return (data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (data.emailVerified is bool);
    }

    function isValidMediaItem(data) {
      return data.userId is string && data.userId.size() == 28 &&
             data.mediaId is int &&
             data.title is string && data.title.size() <= 400 &&
             data.type in ['ANIME', 'MANGA', 'COMMON'] &&
             data.status in ['WATCHING', 'READING', 'COMPLETED', 'PLANNING', 'DROPPED'] &&
             (data.score == null || (data.score is number && data.score >= 0 && data.score <= 10));
    }

    function isValidCharacter(data) {
      return data.id is int && data.name is string && data.name.size() <= 200;
    }

    function isValidAchievement(data) {
       return data.id is string && data.title is string;
    }

    function isValidFriendRequest(data) {
      return data.from is string && data.from == request.auth.uid &&
             data.to is string && data.to != request.auth.uid &&
             data.status in ['PENDING', 'ACCEPTED', 'REJECTED'];
    }

    function isValidMessage(data) {
      return data.senderId is string && data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 2000 &&
             data.type in ['TEXT', 'MEDIA', 'ACHIEVEMENT'];
    }

    // 3. Collection Rules

    // User Profile Rules
    match /users/{userId} {
      allow get, list: if isSignedIn();
      
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      
      allow update: if isOwner(userId) && isEmailVerified() && (
        // Action: Standard Profile Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['username', 'photoURL', 'bannerURL', 'bio', 'preferences', 'updatedAt', 'lastActivityAt', 'status', 'currentActivity', 'lastOnlineAt', 'favoriteAnime', 'weeklyChangesCount', 'todayEpisodesCount', 'lastMarathonUpdate', 'dropsCount', 'location'])) ||
        // Action: Points/Rank Update
        (incoming().diff(existing()).affectedKeys().hasAny(['otakuPoints', 'availablePoints', 'weeklyPoints', 'rank', 'streak', 'streakMultiplier', 'lastStreakUpdate', 'needsHelp', 'helpExpireAt', 'pillsCount', 'savedStreaksCount', 'receivablesPillsCount', 'lastResetAt', 'updatedAt', 'todayEpisodesCount', 'lastMarathonUpdate', 'dropsCount', 'weeklyChangesCount']))
      ) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      
      // PII Isolation: Private Info
      match /private/info {
        allow read, write: if isOwner(userId);
      }

      // Achievements
      match /achievements/{achId} {
        allow read, list: if isSignedIn();
        allow create, update: if isOwner(userId) && isValidAchievement(incoming());
      }

      // Favorites
      match /favorites/characters/items/{itemId} {
        allow read, list: if isSignedIn();
        allow create, update: if isOwner(userId) && isValidCharacter(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Media List Items
    match /users/{userId}/list/{mediaId} {
      allow get, list: if isSignedIn();
      
      allow create: if isOwner(userId) && isEmailVerified() && isValidMediaItem(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && isEmailVerified() && isValidMediaItem(incoming()) &&
                    incoming().mediaId == existing().mediaId &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'score', 'progress', 'notes', 'updatedAt', 'title', 'image']);
      
      allow delete: if isOwner(userId);
    }

    // Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (request.auth.uid == existing().from || request.auth.uid == existing().to);
      allow create: if isSignedIn() && isEmailVerified() && isValidFriendRequest(incoming()) &&
                    incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == existing().to &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status in ['ACCEPTED', 'REJECTED'];
      allow delete: if isSignedIn() && (request.auth.uid == existing().from || request.auth.uid == existing().to);
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read, list: if isSignedIn() && (request.auth.uid in existing().users);
      allow create: if isSignedIn() && isEmailVerified() && (request.auth.uid in incoming().users);
    }

    // Activity Feed
    match /activityFeed/{eventId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time;
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().participants);
      allow create: if isSignedIn() && isEmailVerified() && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (request.auth.uid in existing().participants);

      match /messages/{messageId} {
        allow read, list: if isSignedIn() && 
                          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        
        allow create: if isSignedIn() && isEmailVerified() && 
                      isValidMessage(incoming()) &&
                      (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) &&
                      incoming().createdAt == request.time;
      }
    }

    match /global_media_stats/{animeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isEmailVerified();
    }
  }
}
